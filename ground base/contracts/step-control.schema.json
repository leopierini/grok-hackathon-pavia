{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ground:operator-step-control:v1",
  "title": "Ground operator step control request; separate from robot protocol 2.0-draft",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "snapshot"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "wait_more"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "step_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        }
      },
      "required": [
        "action",
        "request_id",
        "expected_revision",
        "step_id",
        "attempt_id",
        "seconds"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "retry"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "step_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "action",
        "request_id",
        "expected_revision",
        "step_id",
        "attempt_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "halt"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        }
      },
      "required": [
        "action",
        "request_id",
        "expected_revision",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "set_budgets"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "budgets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "properties": {
              "step_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "wait_s": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 300
              },
              "hard_limit_s": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 300
              }
            },
            "required": [
              "step_id",
              "wait_s",
              "hard_limit_s"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "action",
        "request_id",
        "expected_revision",
        "budgets"
      ],
      "additionalProperties": false
    }
  ]
}
